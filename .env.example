# ---------------------------------------------------------------------------
# Frontend (Next.js / Vercel). Только публичные значения!
# Supabase Dashboard → Project Settings → API Keys.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) или legacy anon key — оба подходят.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Edge Function sports-sync — задаются через Supabase Secrets, НЕ в Vercel:
#   supabase secrets set --env-file supabase/.env.functions
# SUPABASE_URL и SUPABASE_SERVICE_ROLE_KEY Supabase
# подставляет в функции автоматически. service_role key никогда не попадает
# во frontend.
# ---------------------------------------------------------------------------
# Пример содержимого supabase/.env.functions:
# SPORTS_PROVIDERS=oddspapi           # единственный источник событий; тестовых данных нет
# CRON_SECRET=длинная-случайная-строка # тот же секрет кладётся в Vault (pickup_cron_secret)
# ODDSPAPI_API_KEY=
# ODDSPAPI_BOOKMAKERS=pinnacle
# ODDSPAPI_MAX_FIXTURES=25
# LOGOS_BATCH=12                      # команд за запуск поиска логотипов
# THESPORTSDB_API_KEY=123             # бесплатный публичный ключ TheSportsDB
# APIFOOTBALL_API_KEY=                # API-Football (тариф Pro): футбол — результаты, live, линии PICKUP
# BALLDONTLIE_API_KEY=                # BALLDONTLIE NHL (ALL-STAR): результаты и статистика НХЛ
# RESULTS_PROVIDERS=balldontlie,opendota,apifootball
# HOUSE_LINES=EPL,OP_35,OP_8,OP_23,OP_34,RPL  # лиги с собственными линиями PICKUP
# PHOTOS_BATCH=10                     # спортсменов за запуск поиска фото
# SPORTMONKS_API_KEY=                 # фото футболистов (Sportmonks Football API); без ключа не используется
# WIKIMEDIA_CONTACT=                  # сайт или почта владельца для User-Agent запросов к Wikimedia
